# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# URL del proyecto y clave pública (segura para exponer en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: SOLO en servidor. NUNCA la expongas en el cliente ni la
# prefijes con NEXT_PUBLIC_. Se usa para operaciones administrativas (creación
# y validación de pedidos del cliente anónimo, etc.).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL base pública de la app (para construir los enlaces de los QR). En local:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firma la cookie de sesión de mesa (escaneo de QR, ver /app/m/[token]).
# Genera una cadena aleatoria propia, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambias en producción, todas las sesiones de mesa abiertas se invalidan.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Stripe (cobro de la suscripción de cada heladería)
# ---------------------------------------------------------------------------
# Clave secreta de la API: Developers -> API keys. SOLO servidor.
# Usa sk_test_... mientras pruebas y sk_live_... en producción.
STRIPE_SECRET_KEY=

# Secreto de firma del webhook. En local lo da el Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# En producción, el que aparece al crear el endpoint en el dashboard.
STRIPE_WEBHOOK_SECRET=

# Ids de los precios recurrentes de cada plan. Los crea `npm run stripe:setup`,
# que los imprime por pantalla para pegarlos aquí.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Configuración del portal de cliente (bpc_...), también de `stripe:setup`. Si
# se deja vacía, Stripe usa la configuración por defecto de la cuenta.
STRIPE_PORTAL_CONFIG=

# Dominio público que usa `stripe:setup` para dar de alta el webhook y los
# enlaces legales del portal. Solo lo lee ese script, no la app.
STRIPE_APP_URL=https://www.cremmo.app
